{
  "data": {
    "variable": "cscba",
    "train_frac": 0.05,
    "val_frac": 0.02,
    "test_frac": 0.93
  },
  "model": {
    "nonlinearity": "siren",
    "hidden_layers": 3,
    "hidden_features": 128,
    "siren_first_omega_0": 30.0,
    "siren_hidden_omega_0": 30.0,
    "wire_omega_0": 3.0,
    "wire_sigma": 3.0
  },
  "train": {
    "total_epochs": 100,
    "batch_size": 2048,
    "initial_lr": 2e-4,
    "scheduler": "oclr",
    "weight_floss": 0.0,
    "weight_rloss": 0.0,
    "rloss_Sigma": 2e-2,
    "rloss_n_samples_frac": 0.01
  },
  "infer": {
    "shortname": "gswa",
    "value_label": "Bouger (maGl)",
    "altitude": 1.0,
    "z_mod": -1.0,
    "preview_size": 2000,
    "grid_res": 1000,
    "chunksize": 1024000,
    "vmin": -1000.0,
    "vmax": 1000.0,
    "dpi": 96
  },
  "runtime": {
    "device": "cuda",
    "seed": 21,
    "tf32": true,
    "use_amp": false,
    "pin_memory": true,
    "run_training": true
  }
}